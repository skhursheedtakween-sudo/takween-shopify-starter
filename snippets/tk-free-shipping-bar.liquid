{%- comment -%}
  snippets/tk-free-shipping-bar.liquid — free-delivery progress bar (brief §8).
  Threshold set in Theme settings (tk_free_shipping_threshold, major units, store default currency).
  Hidden when the threshold is 0. Uses the cart total in the store's default currency.
{%- endcomment -%}
{%- liquid
  assign threshold = settings.tk_free_shipping_threshold | default: 0
  assign threshold_cents = threshold | times: 100
-%}
{%- if threshold_cents > 0 -%}
  {%- liquid
    assign remaining = threshold_cents | minus: cart.total_price
    assign pct = cart.total_price | times: 100.0 | divided_by: threshold_cents
    if pct > 100
      assign pct = 100
    endif
  -%}
  <div class="tk-ship-bar{% if cart == empty %} tk-ship-bar--hidden{% endif %}" aria-live="polite">
    <p class="tk-ship-bar__text">
      {%- if remaining > 0 -%}
        {{ 'tk.cart.free_shipping_progress_html' | t: amount: remaining | money }}
      {%- else -%}
        {{ 'tk.cart.free_shipping_reached' | t }}
      {%- endif -%}
    </p>
    <div class="tk-ship-bar__track">
      <div class="tk-ship-bar__fill" style="width: {{ pct }}%;" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct | round }}"></div>
    </div>
  </div>
{%- endif -%}
