{%- comment -%}
  snippets/tk-css-variables.liquid
  Renders Takween design tokens as CSS custom properties on :root.
  Loaded in layout/theme.liquid immediately following Dawn's base font/colour variables.
  v2 "Premium Editorial" Approved Spec.

  NOTE ON ROOT FONT SIZE:
  Dawn sets `html { font-size: calc(var(--font-body-scale) * 62.5%) }`, which means
  1rem = 10px (at 100% body scale), NOT 16px!
  All typography tokens here use explicit `px` values inside `clamp()` so that text sizes
  compute exactly as intended across all viewports regardless of rem base confusion.
{%- endcomment -%}

{%- liquid
  assign spacing_scale = settings.tk_spacing_scale | default: 'default'
  case spacing_scale
    when 'compact'
      assign spacing_multiplier = 0.67
    when 'spacious'
      assign spacing_multiplier = 1.33
    else
      assign spacing_multiplier = 1.0
  endcase

  assign container_max_w = settings.tk_container_width | default: 1360
  assign grid_gap_desktop = settings.tk_grid_gap | default: 20
  assign button_radius = settings.tk_button_radius | default: 999
  assign card_radius = settings.tk_card_radius | default: 4
  assign input_radius = settings.tk_input_radius | default: 4
  assign button_style = settings.tk_button_style | default: 'solid'
  assign button_transform = settings.tk_button_text_transform | default: 'none'

  assign color_sale = settings.tk_color_sale | default: '#A3361F'
  assign color_success = settings.tk_color_success | default: '#3F5A2E'
  assign color_low_stock = settings.tk_color_low_stock | default: '#9A3412'
  assign color_sold_out = settings.tk_color_sold_out | default: '#1C1A17'
-%}

<style id="tk-css-tokens">
  :root {
    /* --- Takween Layout & Spacing Tokens (v2 Premium Editorial) --- */
    --tk-spacing-mult: {{ spacing_multiplier }};
    --tk-container: {{ container_max_w }}px;
    --tk-gutter: clamp(20px, 4vw, 40px);
    --tk-gap: clamp(16px, 2.5vw, {{ grid_gap_desktop }}px);

    /* 4/8px base spacing scale scaled by multiplier */
    --tk-space-1: calc(4px * var(--tk-spacing-mult));
    --tk-space-2: calc(8px * var(--tk-spacing-mult));
    --tk-space-3: calc(12px * var(--tk-spacing-mult));
    --tk-space-4: calc(16px * var(--tk-spacing-mult));
    --tk-space-5: calc(24px * var(--tk-spacing-mult));
    --tk-space-6: calc(32px * var(--tk-spacing-mult));
    --tk-space-7: calc(48px * var(--tk-spacing-mult));
    --tk-space-8: calc(64px * var(--tk-spacing-mult));
    --tk-space-9: calc(96px * var(--tk-spacing-mult));
    --tk-space-10: calc(112px * var(--tk-spacing-mult));

    /* Section padding scale: 112px desktop / 64px mobile at default (1.0) */
    --tk-section-pt-default: clamp(64px, 8vw, calc(112px * var(--tk-spacing-mult)));
    --tk-section-pb-default: clamp(64px, 8vw, calc(112px * var(--tk-spacing-mult)));

    /* --- Takween v2 Typography Scale (Fraunces Display + Instrument Sans UI) --- */
    /* Hero Display: clamp(56px, 8vw, 116px), weight 350, line-height 0.92, letter-spacing -0.035em */
    --tk-text-display: clamp(56px, 8vw, 116px);
    --tk-leading-display: 0.92;
    --tk-tracking-display: -0.035em;
    --tk-weight-display: 350;

    /* Section H1 / Product H1: 52px desktop -> 38px mobile 375px, weight 350, lh 1.0 */
    --tk-text-5xl: clamp(38px, 32px + 1.8vw, 52px);
    --tk-leading-5xl: 1.0;
    --tk-tracking-5xl: -0.03em;
    --tk-weight-5xl: 350;

    /* Section H2: clamp(40px, 4.4vw, 60px), weight 350, lh 1.0, ls -0.03em */
    --tk-text-4xl: clamp(40px, 4.4vw, 60px);
    --tk-leading-4xl: 1.0;
    --tk-tracking-4xl: -0.03em;
    --tk-weight-4xl: 350;

    /* H3: clamp(20px, 18px + 0.5vw, 24px), weight 400 */
    --tk-text-3xl: clamp(20px, 18px + 0.5vw, 24px);
    --tk-leading-3xl: 1.25;
    --tk-tracking-3xl: -0.01em;
    --tk-weight-3xl: 400;

    /* Marquee & quotes: Fraunces italic 300, 22px marquee */
    --tk-text-marquee: 22px;
    --tk-leading-marquee: 1.2;

    /* Card title: 15px Instrument Sans, weight 500, line-height 1.4 */
    --tk-card-title-size: 15px;
    --tk-card-title-leading: 1.4;
    --tk-card-title-weight: 500;

    /* Body: 16px - 18px, line-height 1.6 - 1.7 */
    --tk-text-base: 16px;
    --tk-text-lg: 18px;
    --tk-leading-base: 1.65;

    /* Small & meta: 14px / 13px */
    --tk-text-sm: 14px;
    --tk-text-xs: 12px;
    --tk-leading-sm: 1.45;

    /* Eyebrow: 12px Instrument Sans, weight 600, uppercase, ls 0.16em, olive #5E6B47 */
    --tk-eyebrow-size: 12px;
    --tk-eyebrow-weight: 600;
    --tk-eyebrow-tracking: 0.16em;
    --tk-eyebrow-transform: uppercase;

    /* Button text: 15px, weight 500-600 */
    --tk-btn-text-size: 15px;
    --tk-btn-weight: 550;

    /* --- Takween v2 Shape Tokens --- */
    --tk-radius-button: {{ button_radius }}px;
    --tk-radius-card: {{ card_radius }}px;
    --tk-radius-input: {{ input_radius }}px;
    --tk-radius-badge: 999px;
    --tk-radius-size-btn: 4px;
    --tk-button-style: {{ button_style }};
    --tk-button-transform: {{ button_transform }};
    --tk-button-height: 54px;
    --tk-touch-target: 44px;

    /* --- Takween v2 Color Palette Tokens --- */
    --tk-color-linen: #F3EFE8;
    --tk-color-paper: #FBF9F5;
    --tk-color-espresso: #1C1A17;
    --tk-color-ink: #1C1A17;
    --tk-color-sand: #E3DACB;
    --tk-color-stone: #ECE6DC;
    --tk-color-olive: #5E6B47;
    --tk-color-muted: #4D473F;
    --tk-color-meta: #6B645B;
    --tk-color-faint: #8C8478;
    --tk-color-border: #DDD5C9;
    --tk-color-input-border: #CFC6B8;
    --tk-color-tile: #E9E2D6;
    --tk-color-surface: #FBF9F5;
    --tk-color-bg: #F3EFE8;
    --tk-color-accent: #5E6B47;

    /* Status colours */
    --tk-color-sale: {{ color_sale }};
    --tk-color-success: {{ color_success }};
    --tk-color-low-stock: {{ color_low_stock }};
    --tk-color-soldout: {{ color_sold_out }};

    /* Espresso section specific text and border */
    --tk-color-espresso-text: #EDE6DA;
    --tk-color-espresso-muted: #C9C0B3;
    --tk-color-espresso-faint: #A89F92;
    --tk-color-espresso-line: #36322D;

    /* --- Takween Elevation & Transitions --- */
    --tk-shadow-sm: 0 1px 3px rgba(28, 26, 23, 0.05);
    --tk-shadow-md: 0 4px 16px rgba(28, 26, 23, 0.07);
    --tk-shadow-lg: 0 12px 32px rgba(28, 26, 23, 0.09);

    --tk-transition-fast: 150ms cubic-bezier(0.2, 0, 0, 1);
    --tk-transition-base: 180ms ease;
    --tk-transition: 180ms ease;
    --tk-transition-slow: 400ms cubic-bezier(0.2, 0, 0, 1);

    /* --- Takween Z-Index Hierarchy --- */
    --tk-z-base: 1;
    --tk-z-dropdown: 50;
    --tk-z-sticky: 100;
    --tk-z-header: 200;
    --tk-z-sticky-atc: 300;
    --tk-z-drawer-backdrop: 400;
    --tk-z-drawer: 500;
    --tk-z-modal: 600;
    --tk-z-toast: 700;

    /* --- Accessible Focus Outline (2px ink, 3px offset) --- */
    --tk-focus-ring: 2px solid #1C1A17;
    --tk-focus-offset: 3px;
  }
</style>
