{%- comment -%}
  snippets/tk-icon.liquid
  Renders an accessible inline SVG stroke icon from the Takween icon set.

  Parameters:
  - icon: {String} Name of the icon (required)
  - size: {Number} Icon width/height in pixels. Default: 20
  - class: {String} Extra CSS class(es) to append
  - aria_hidden: {Boolean} Whether to hide from screen readers. Default: true
  - aria_label: {String} Screen reader label if not hidden

  Usage:
  {% render 'tk-icon', icon: 'cart', size: 20 %}
  {% render 'tk-icon', icon: 'check', size: 16, class: 'tk-success-icon' %}
{%- endcomment -%}

{%- liquid
  assign icon_name = icon | strip
  assign icon_size = size | default: 20
  assign icon_stroke = stroke_width | default: 1.8
  assign is_hidden = aria_hidden | default: true
-%}

<svg
  class="tk-icon tk-icon--{{ icon_name }}{% if class %} {{ class }}{% endif %}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="{{ icon_stroke }}"
  stroke-linecap="round"
  stroke-linejoin="round"
  {% if is_hidden %}
    aria-hidden="true"
    focusable="false"
  {% elsif aria_label %}
    role="img"
    aria-label="{{ aria_label | escape }}"
  {% endif %}
>
  {%- case icon_name -%}
    {%- when 'cart' -%}
      <circle cx="9" cy="20" r="1.5"></circle>
      <circle cx="18" cy="20" r="1.5"></circle>
      <path d="M2.5 3.5h3l2.4 12h11.2l2.4-8.5H6.5"></path>

    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"></circle>
      <line x1="21" y1="21" x2="16.5" y2="16.5"></line>

    {%- when 'account' -%}
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>

    {%- when 'menu' -%}
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>

    {%- when 'close' -%}
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>

    {%- when 'chevron-down' -%}
      <polyline points="6 9 12 15 18 9"></polyline>

    {%- when 'chevron-left' -%}
      <polyline points="15 18 9 12 15 6"></polyline>

    {%- when 'chevron-right' -%}
      <polyline points="9 18 15 12 9 6"></polyline>

    {%- when 'plus' -%}
      <line x1="12" y1="5" x2="12" y2="19"></line>
      <line x1="5" y1="12" x2="19" y2="12"></line>

    {%- when 'minus' -%}
      <line x1="5" y1="12" x2="19" y2="12"></line>

    {%- when 'check' -%}
      <polyline points="20 6 9 17 4 12"></polyline>

    {%- when 'truck' -%}
      <rect x="1" y="4" width="15" height="12" rx="1.5"></rect>
      <path d="M16 8h4.5l2.5 4v4h-7V8z"></path>
      <circle cx="5.5" cy="18.5" r="2"></circle>
      <circle cx="18.5" cy="18.5" r="2"></circle>

    {%- when 'return' -%}
      <polyline points="1 4 1 10 7 10"></polyline>
      <path d="M3.5 15a9 9 0 1 0 2.1-9.3L1 10"></path>

    {%- when 'shield' -%}
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>

    {%- when 'star' -%}
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="currentColor"></polygon>

    {%- when 'star-half' -%}
      <defs>
        <linearGradient id="tk-star-half-grad">
          <stop offset="50%" stop-color="currentColor" />
          <stop offset="50%" stop-color="transparent" />
        </linearGradient>
      </defs>
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="url(#tk-star-half-grad)"></polygon>

    {%- when 'mail' -%}
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
      <polyline points="22,6 12,13 2,6"></polyline>

    {%- when 'phone' -%}
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>

    {%- when 'map-pin' -%}
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
      <circle cx="12" cy="10" r="3"></circle>

    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>

    {%- when 'arrow-right' -%}
      <path d="M5 12h14"></path>
      <path d="M13 6l6 6-6 6"></path>

    {%- when 'arrow-up-right' -%}
      <path d="M7 17L17 7"></path>
      <path d="M9 7h8v8"></path>

    {%- else -%}
      <circle cx="12" cy="12" r="9"></circle>
  {%- endcase -%}
</svg>
