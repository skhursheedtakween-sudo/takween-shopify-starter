{%- comment -%}
  snippets/tk-button.liquid
  Renders an accessible button or link styled with Takween .tk-btn styles.

  Parameters:
  - label: {String} Button text content (required)
  - url: {String} Destination URL. If present, renders <a>, else <button>
  - style: {String} 'primary' | 'secondary' | 'outline' | 'link'. Default: 'primary'
  - size: {String} 'sm' | 'md' | 'lg'. Default: 'md'
  - full_width: {Boolean} Full width display. Default: false
  - icon: {String} Name of tk-icon to render alongside label
  - icon_position: {String} 'left' | 'right'. Default: 'right'
  - attributes: {String} Raw HTML attributes (e.g. 'aria-haspopup="dialog"')
  - disabled: {Boolean} Disabled state
  - type: {String} Button type attribute ('button' | 'submit'). Default: 'button'
  - class: {String} Additional classes to append

  Usage:
  {% render 'tk-button', label: 'Add to cart', style: 'primary' %}
  {% render 'tk-button', label: 'Shop apparel', url: '/collections/apparel', style: 'secondary' %}
{%- endcomment -%}

{%- liquid
  assign btn_style = style | default: 'primary'
  assign btn_class = 'tk-btn tk-btn--' | append: btn_style
  if full_width
    assign btn_class = btn_class | append: ' tk-btn--full'
  endif
  if class
    assign btn_class = btn_class | append: ' ' | append: class
  endif

  assign icon_pos = icon_position | default: 'right'
-%}

{%- if url != blank -%}
  <a
    href="{{ url }}"
    class="{{ btn_class }}"
    {% if disabled %}aria-disabled="true" tabindex="-1"{% endif %}
    {{ attributes }}
  >
    {%- if icon != blank and icon_pos == 'left' -%}
      {% render 'tk-icon', icon: icon, size: 18, class: 'tk-btn__icon tk-btn__icon--left' %}
    {%- endif -%}
    <span>{{ label }}</span>
    {%- if icon != blank and icon_pos == 'right' -%}
      {% render 'tk-icon', icon: icon, size: 18, class: 'tk-btn__icon tk-btn__icon--right' %}
    {%- endif -%}
  </a>
{%- else -%}
  <button
    type="{{ type | default: 'button' }}"
    class="{{ btn_class }}"
    {% if disabled %}disabled="disabled" aria-disabled="true"{% endif %}
    {{ attributes }}
  >
    {%- if icon != blank and icon_pos == 'left' -%}
      {% render 'tk-icon', icon: icon, size: 18, class: 'tk-btn__icon tk-btn__icon--left' %}
    {%- endif -%}
    <span>{{ label }}</span>
    {%- if icon != blank and icon_pos == 'right' -%}
      {% render 'tk-icon', icon: icon, size: 18, class: 'tk-btn__icon tk-btn__icon--right' %}
    {%- endif -%}
  </button>
{%- endif -%}
