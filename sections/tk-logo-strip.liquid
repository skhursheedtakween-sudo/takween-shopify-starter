{%- comment -%}
  sections/tk-logo-strip.liquid
  Takween Logo / Trust-Mark Strip Section.
  Row or marquee of partner / press logos.
  Grayscale toggle, opacity hover states, responsive logo row counts.
  Accessible marquee (pauses on hover/focus, disabled under prefers-reduced-motion).
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .tk-logo-strip--{{ section.id }} {
    --tk-logo-height: {{ section.settings.logo_max_height }}px;
    --tk-logo-cols-desktop: {{ section.settings.logos_per_row_desktop }};
    --tk-logo-cols-mobile: {{ section.settings.logos_per_row_mobile }};
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="tk-container section-{{ section.id }}-padding">
    <div class="tk-logo-strip tk-logo-strip--{{ section.id }}">
      {%- if section.settings.label_text != blank -%}
        <div class="tk-logo-strip__label">
          {{ section.settings.label_text | escape }}
        </div>
      {%- endif -%}

      {%- if section.settings.layout == 'marquee' -%}
        <!-- Marquee Layout -->
        <div class="tk-logo-strip__marquee-track" tabindex="0" role="region" aria-label="{{ section.settings.label_text | default: 'Logos' | escape }}">
          <div class="tk-logo-strip__marquee-inner{% if section.settings.grayscale %} tk-logo-strip--grayscale{% endif %}">
            <div class="tk-logo-strip__marquee-group">
              {%- for block in section.blocks -%}
                <div class="tk-logo-strip__item" {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" class="tk-logo-strip__link" target="_blank" rel="noopener noreferrer">
                  {%- endif -%}

                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: height: 160
                      | image_tag:
                        height: section.settings.logo_max_height,
                        loading: 'lazy',
                        class: 'tk-logo-strip__image',
                        alt: block.settings.alt_text | default: block.settings.image.alt | default: 'Logo' | escape
                    }}
                  {%- else -%}
                    <div class="tk-logo-strip__placeholder">
                      {{ 'logo' | placeholder_svg_tag: 'tk-placeholder-svg' }}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.link != blank -%}
                    </a>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>

            <!-- Duplicate set for infinite marquee loop (aria-hidden for screen readers) -->
            <div class="tk-logo-strip__marquee-group" aria-hidden="true">
              {%- for block in section.blocks -%}
                <div class="tk-logo-strip__item">
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" class="tk-logo-strip__link" tabindex="-1">
                  {%- endif -%}

                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: height: 160
                      | image_tag:
                        height: section.settings.logo_max_height,
                        loading: 'lazy',
                        class: 'tk-logo-strip__image',
                        alt: ''
                    }}
                  {%- else -%}
                    <div class="tk-logo-strip__placeholder">
                      {{ 'logo' | placeholder_svg_tag: 'tk-placeholder-svg' }}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.link != blank -%}
                    </a>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- else -%}
        <!-- Grid Layout -->
        <div class="tk-logo-strip__grid{% if section.settings.grayscale %} tk-logo-strip--grayscale{% endif %}">
          {%- for block in section.blocks -%}
            <div class="tk-logo-strip__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="tk-logo-strip__link" target="_blank" rel="noopener noreferrer">
              {%- endif -%}

              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: height: 160
                  | image_tag:
                    height: section.settings.logo_max_height,
                    loading: 'lazy',
                    class: 'tk-logo-strip__image',
                    alt: block.settings.alt_text | default: block.settings.image.alt | default: 'Logo' | escape
                }}
              {%- else -%}
                <div class="tk-logo-strip__placeholder">
                  {{ 'logo' | placeholder_svg_tag: 'tk-placeholder-svg' }}
                </div>
              {%- endif -%}

              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .tk-logo-strip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--tk-space-4);
  }

  .tk-logo-strip__label {
    font-size: 1.3rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tk-color-muted);
    text-align: center;
  }

  /* Grid Layout */
  .tk-logo-strip__grid {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(var(--tk-logo-cols-mobile, 3), 1fr);
    align-items: center;
    justify-items: center;
    gap: var(--tk-space-4);
  }

  @media screen and (min-width: 750px) {
    .tk-logo-strip__grid {
      grid-template-columns: repeat(var(--tk-logo-cols-desktop, 5), 1fr);
      gap: var(--tk-space-6);
    }
  }

  .tk-logo-strip__item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--tk-logo-height, 40px);
  }

  .tk-logo-strip__link {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    transition: opacity var(--tk-transition), filter var(--tk-transition);
  }

  .tk-logo-strip__image {
    max-height: var(--tk-logo-height, 40px);
    width: auto;
    object-fit: contain;
    transition: filter var(--tk-transition), opacity var(--tk-transition);
  }

  .tk-logo-strip__placeholder {
    height: var(--tk-logo-height, 40px);
    width: 100px;
  }

  /* Grayscale filter and hover */
  .tk-logo-strip--grayscale .tk-logo-strip__image,
  .tk-logo-strip--grayscale .tk-logo-strip__placeholder {
    filter: grayscale(100%);
    opacity: 0.7;
  }

  .tk-logo-strip--grayscale .tk-logo-strip__link:hover .tk-logo-strip__image,
  .tk-logo-strip--grayscale .tk-logo-strip__link:focus-visible .tk-logo-strip__image,
  .tk-logo-strip--grayscale .tk-logo-strip__item:hover .tk-logo-strip__image {
    filter: grayscale(0%);
    opacity: 1;
  }

  /* Marquee Layout */
  .tk-logo-strip__marquee-track {
    width: 100%;
    overflow: hidden;
    position: relative;
    outline: none;
  }

  .tk-logo-strip__marquee-track:focus-visible {
    outline: 2px solid var(--tk-color-accent);
    outline-offset: 4px;
    border-radius: var(--tk-radius-input);
  }

  .tk-logo-strip__marquee-inner {
    display: flex;
    width: max-content;
    animation: tkLogoMarquee 28s linear infinite;
  }

  .tk-logo-strip__marquee-group {
    display: flex;
    align-items: center;
    gap: var(--tk-space-7);
    padding-right: var(--tk-space-7);
    flex-shrink: 0;
  }

  .tk-logo-strip__marquee-track:hover .tk-logo-strip__marquee-inner,
  .tk-logo-strip__marquee-track:focus-within .tk-logo-strip__marquee-inner {
    animation-play-state: paused;
  }

  @keyframes tkLogoMarquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tk-logo-strip__marquee-inner {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
    }

    .tk-logo-strip__marquee-group {
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--tk-space-4);
      padding-right: 0;
    }

    .tk-logo-strip__marquee-group[aria-hidden="true"] {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Logo strip",
  "tag": "section",
  "class": "tk-section-logo-strip",
  "settings": [
    {
      "type": "paragraph",
      "content": "Use real client/partner logos only with permission."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Header label",
      "default": "As featured in"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "marquee",
          "label": "Infinite marquee"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "logos_per_row_desktop",
      "min": 3,
      "max": 8,
      "step": 1,
      "label": "Logos per row on desktop",
      "default": 5
    },
    {
      "type": "range",
      "id": "logos_per_row_mobile",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Logos per row on mobile",
      "default": 3
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Maximum logo height",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Show logos in grayscale (colour on hover)",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link destination"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text / Brand name",
          "default": "Brand logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo strip",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
