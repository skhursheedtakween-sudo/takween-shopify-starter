{%- comment -%}
  sections/tk-faq.liquid — FAQ accordion (brief §5).
  Content source:
  - blocks: question/answer blocks added in the Theme Editor
  - metaobjects: a list of `faq_item` metaobject entries (Content → Metaobjects), so the same FAQs
    can be reused on the FAQ page and product pages (see docs/DATA_MODEL.md)
  Native <details>/<summary> accordion — works without JS, keyboard accessible.
  Optional FAQPage JSON-LD (off by default).
  Styles: assets/tk-faq.css · Design: docs/design-reference/home-desktop.html (FAQ)
{%- endcomment -%}

{{ 'tk-faq.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign use_metaobjects = false
  if section.settings.source == 'metaobjects' and section.settings.faq_items.size > 0
    assign use_metaobjects = true
  endif
-%}

<section
  class="tk-faq tk-faq--{{ section.settings.layout }} tk-section color-{{ section.settings.color_scheme }} gradient"
  style="--tk-pt: {{ section.settings.padding_top }}px; --tk-pb: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="TkFaqHeading-{{ section.id }}"
>
  <div class="tk-container tk-faq__inner">
    <div class="tk-faq__intro">
      {%- if section.settings.eyebrow != blank -%}
        <span class="tk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 id="TkFaqHeading-{{ section.id }}" class="tk-h2 tk-faq__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="tk-faq__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="tk-faq__list">
      {%- if use_metaobjects -%}
        {%- for item in section.settings.faq_items -%}
          <details class="tk-faq__item"{% if forloop.first and section.settings.open_first %} open{% endif %}>
            <summary class="tk-faq__question">
              <span>{{ item.question.value | escape }}</span>
              <span class="tk-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="tk-faq__answer">{{ item.answer | metafield_tag }}</div>
          </details>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <details class="tk-faq__item"{% if forloop.first and section.settings.open_first %} open{% endif %} {{ block.shopify_attributes }}>
            <summary class="tk-faq__question">
              <span>{{ block.settings.question | escape }}</span>
              <span class="tk-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="tk-faq__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.enable_schema -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- if use_metaobjects -%}
            {%- for item in section.settings.faq_items -%}
              {
                "@type": "Question",
                "name": {{ item.question.value | json }},
                "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | metafield_text | json }} }
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {
                "@type": "Question",
                "name": {{ block.settings.question | json }},
                "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          {%- endif -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "class": "tk-section-faq",
  "max_blocks": 16,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Heading left, questions right" },
        { "value": "stacked", "label": "Stacked (centred column)" }
      ],
      "default": "split"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Help"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Questions, <em>answered.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>Can’t find what you need? <a href=\"/pages/contact\" title=\"Contact\">Contact us</a></p>"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Questions source",
      "options": [
        { "value": "blocks", "label": "Blocks in this section" },
        { "value": "metaobjects", "label": "FAQ item metaobjects" }
      ],
      "default": "blocks"
    },
    {
      "type": "metaobject_list",
      "id": "faq_items",
      "label": "FAQ items",
      "metaobject_type": "faq_item",
      "limit": 20,
      "info": "Used when the source is “FAQ item metaobjects”. Manage entries in Content → Metaobjects."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_schema",
      "label": "Output FAQPage structured data",
      "default": false,
      "info": "Only enable on one FAQ section per page, with real answers."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does delivery take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>UK orders usually arrive within 2–4 working days. [Sample content]</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" },
        {
          "type": "question",
          "settings": {
            "question": "What is your returns policy?",
            "answer": "<p>Unworn items can be returned within 30 days of delivery. [Sample content]</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How does the sizing run?",
            "answer": "<p>Our sizes are true to fit. Between sizes? Choose the larger size for a relaxed look.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
