{%- comment -%}
  sections/tk-footer.liquid — Takween v2 footer (footer group). Replaces Dawn's footer.
  Design: docs/design-reference/home-desktop.html (footer).
  - 12-column grid: brand (4) · menus (2 each) · business info (2); tablet 2×2; mobile accordions.
  - Oversized wordmark scaled to the container width by <tk-fit-text> (CSS clamp fallback).
  - Bottom bar: copyright · legal links (menu or store policies) · localization · payment icons.
  Styles: assets/tk-footer.css · JS: assets/tk-fit-text.js
{%- endcomment -%}

{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{{ 'tk-footer.css' | asset_url | stylesheet_tag }}
{%- if section.settings.show_large_wordmark -%}
  <script src="{{ 'tk-fit-text.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<footer
  class="tk-footer color-{{ section.settings.color_scheme }} gradient"
  style="--tk-footer-pt: {{ section.settings.padding_top }}px; --tk-footer-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="tk-footer__inner">
    {%- if section.blocks.size > 0 -%}
      <div class="tk-footer__grid">
        {%- for block in section.blocks -%}
          <div class="tk-footer__block tk-footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'brand' -%}
                {%- if block.settings.logo != blank -%}
                  <a href="{{ routes.root_url }}" class="tk-footer__logo">
                    {%- liquid
                      assign logo_w = block.settings.logo_width
                      assign logo_h = logo_w | divided_by: block.settings.logo.aspect_ratio | round
                    -%}
                    {{
                      block.settings.logo
                      | image_url: width: 480
                      | image_tag:
                        widths: '160, 240, 320, 480',
                        sizes: '(min-width: 750px) 240px, 50vw',
                        loading: 'lazy',
                        width: logo_w,
                        height: logo_h,
                        style: 'max-width: 100%;',
                        alt: shop.name
                    }}
                  </a>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <p class="tk-footer__intro">{{ block.settings.heading }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="tk-footer__brand-text">{{ block.settings.text }}</div>
                {%- endif -%}

              {%- when 'menu' -%}
                {%- assign menu_links = block.settings.menu.links -%}
                <div class="tk-footer__menu-desktop">
                  {%- if block.settings.heading != blank -%}
                    <h2 class="tk-footer__heading">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if menu_links.size > 0 -%}
                    <ul class="tk-footer__links" role="list">
                      {%- for link in menu_links -%}
                        <li>
                          <a
                            href="{{ link.url }}"
                            class="tk-footer__link"
                            {% if link.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{- link.title | escape -}}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- elsif request.design_mode -%}
                    <p class="tk-footer__hint">{{ 'tk.footer.select_menu' | t }}</p>
                  {%- endif -%}
                </div>

                {%- if menu_links.size > 0 -%}
                  <details class="tk-footer__menu-mobile">
                    <summary>
                      <span class="tk-footer__heading">{{ block.settings.heading | default: block.settings.menu.title }}</span>
                      {% render 'tk-icon', icon: 'chevron-down', size: 18, stroke_width: 1.5 %}
                    </summary>
                    <ul class="tk-footer__links" role="list">
                      {%- for link in menu_links -%}
                        <li><a href="{{ link.url }}" class="tk-footer__link">{{ link.title | escape }}</a></li>
                      {%- endfor -%}
                    </ul>
                  </details>
                {%- endif -%}

              {%- when 'business_info' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="tk-footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <address class="tk-footer__contact" style="font-style: normal;">
                  {%- if block.settings.address != blank -%}
                    <p>{{ block.settings.address | escape | newline_to_br }}</p>
                  {%- endif -%}
                  {%- if block.settings.phone != blank -%}
                    <p><a href="tel:{{ block.settings.phone | remove: ' ' | escape }}">{{ block.settings.phone | escape }}</a></p>
                  {%- endif -%}
                  {%- if block.settings.email != blank -%}
                    <p><a href="mailto:{{ block.settings.email | escape }}">{{ block.settings.email | escape }}</a></p>
                  {%- endif -%}
                  {%- if block.settings.opening_hours != blank -%}
                    <div class="tk-footer__hours">{{ block.settings.opening_hours }}</div>
                  {%- endif -%}
                </address>

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="tk-footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <div class="tk-footer__text">{{ block.settings.text }}</div>

              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="tk-footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="tk-footer__newsletter-text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
                {%- form 'customer', id: 'TkFooterNewsletter', class: 'tk-footer__newsletter' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <label for="TkFooterNewsletter-email" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
                  <div class="tk-footer__newsletter-row">
                    <input
                      id="TkFooterNewsletter-email"
                      type="email"
                      name="contact[email]"
                      class="tk-footer__newsletter-input"
                      value="{{ form.email }}"
                      placeholder="{{ 'newsletter.label' | t }}"
                      autocomplete="email"
                      autocorrect="off"
                      autocapitalize="off"
                      required
                      {% if form.errors %}
                        aria-invalid="true" aria-describedby="TkFooterNewsletter-error"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="TkFooterNewsletter-success"
                      {% endif %}
                    >
                    <button type="submit" class="tk-footer__newsletter-submit" aria-label="{{ 'newsletter.button_label' | t }}">
                      {% render 'tk-icon', icon: 'arrow-right', size: 18, stroke_width: 1.6 %}
                    </button>
                  </div>
                  {%- if form.errors -%}
                    <p id="TkFooterNewsletter-error" class="tk-footer__form-message" role="alert">
                      {{ form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email }}
                    </p>
                  {%- elsif form.posted_successfully? -%}
                    <p id="TkFooterNewsletter-success" class="tk-footer__form-message" role="status">
                      {{ 'newsletter.success' | t }}
                    </p>
                  {%- endif -%}
                {%- endform -%}

              {%- when 'social' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="tk-footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- render 'social-icons', class: 'footer__list-social' -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_large_wordmark -%}
      <div class="tk-footer__wordmark-wrap" aria-hidden="true">
        <tk-fit-text class="tk-footer__wordmark">
          {{- section.settings.wordmark_text | default: shop.name | escape -}}
        </tk-fit-text>
      </div>
    {%- endif -%}

    <div class="tk-footer__bottom">
      <p class="tk-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name | escape }}.
        {%- if section.settings.custom_copyright != blank -%}
          {{ section.settings.custom_copyright | escape }}
        {%- else -%}
          {{ 'tk.footer.rights' | t }}
        {%- endif -%}
      </p>

      {%- liquid
        assign legal_links = section.settings.legal_menu.links
      -%}
      {%- if legal_links.size > 0 or shop.privacy_policy or shop.terms_of_service -%}
        <ul class="tk-footer__legal" role="list">
          {%- if legal_links.size > 0 -%}
            {%- for link in legal_links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- if shop.privacy_policy -%}
              <li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a></li>
            {%- endif -%}
            {%- if shop.terms_of_service -%}
              <li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title | escape }}</a></li>
            {%- endif -%}
          {%- endif -%}
        </ul>
      {%- endif -%}

      <div class="tk-footer__bottom-right">
        {%- liquid
          assign show_country = false
          if section.settings.enable_country_selector and localization.available_countries.size > 1
            assign show_country = true
          endif
          assign show_language = false
          if section.settings.enable_language_selector and localization.available_languages.size > 1
            assign show_language = true
          endif
        -%}
        {%- if show_country or show_language -%}
          <div class="tk-footer__localization">
            {%- if show_country -%}
              <localization-form>
                {%- form 'localization', id: 'TkFooterCountryForm', class: 'localization-form' -%}
                  <div>
                    <h2 class="visually-hidden" id="TkFooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                    {%- render 'country-localization', localPosition: 'TkFooterCountry' -%}
                  </div>
                {%- endform -%}
              </localization-form>
            {%- endif -%}
            {%- if show_language -%}
              <localization-form>
                {%- form 'localization', id: 'TkFooterLanguageForm', class: 'localization-form' -%}
                  <div>
                    <h2 class="visually-hidden" id="TkFooterLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                    {%- render 'language-localization', localPosition: 'TkFooterLanguage' -%}
                  </div>
                {%- endform -%}
              </localization-form>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.payment_enable and shop.enabled_payment_types.size > 0 -%}
          <div class="footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "tk-footer-section",
  "max_blocks": 7,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Large wordmark"
    },
    {
      "type": "checkbox",
      "id": "show_large_wordmark",
      "label": "Show large wordmark",
      "default": true
    },
    {
      "type": "text",
      "id": "wordmark_text",
      "label": "Wordmark text",
      "info": "Leave blank to use the store name. Scales to the full footer width."
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "custom_copyright",
      "label": "Copyright note",
      "default": "All rights reserved."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal links menu",
      "info": "Optional. If empty, the store's Privacy policy and Terms of service are linked automatically (Settings → Policies)."
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_country_selector.label",
      "info": "To add a country/region, go to your [market settings.](/admin/settings/markets)"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_language_selector.label",
      "info": "To add a language, go to your [language settings.](/admin/settings/languages)"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "t:sections.footer.settings.payment_enable.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 32,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image",
          "info": "Optional. v2 design uses the intro line only."
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 80,
          "max": 300,
          "step": 10,
          "unit": "px",
          "label": "Logo width",
          "default": 140
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Intro line",
          "default": "Considered essentials for wardrobe and home."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Supporting text (optional)"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Quick links",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "business_info",
      "name": "Business info",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Visit us",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "address",
          "default": "[Business address]",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        },
        {
          "type": "richtext",
          "id": "opening_hours",
          "label": "Opening hours"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "About",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Share your brand story, values or commitments here.</p>",
          "label": "Text"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Join the list",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "default": "New arrivals and considered stories. No noise.",
          "label": "Subtext"
        }
      ]
    },
    {
      "type": "social",
      "name": "Social icons",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Follow us",
          "label": "Heading"
        },
        {
          "type": "paragraph",
          "content": "Add social links in Theme settings → Social media."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "menu", "settings": { "heading": "Shop", "menu": "footer-shop" } },
        { "type": "menu", "settings": { "heading": "Help", "menu": "footer-help" } },
        { "type": "menu", "settings": { "heading": "Company", "menu": "footer-company" } },
        { "type": "business_info" }
      ]
    }
  ]
}
{% endschema %}
