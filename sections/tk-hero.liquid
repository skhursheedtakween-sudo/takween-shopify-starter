{%- comment -%}
  sections/tk-hero.liquid
  Takween Hero Section.
  Supports contained/full-width, 9-position content placement, white content card toggle,
  eager/fetchpriority loading on section.index == 1, and responsive desktop/mobile imagery.
{%- endcomment -%}

{%- liquid
  assign is_first_section = false
  if section.index == 1
    assign is_first_section = true
  endif

  assign fetch_priority = 'auto'
  assign loading_strategy = 'lazy'
  if is_first_section
    assign fetch_priority = 'high'
    assign loading_strategy = 'eager'
  endif

  assign min_h_desktop = '820px'
  case section.settings.height
    when 'small'
      assign min_h_desktop = '560px'
    when 'medium'
      assign min_h_desktop = '720px'
    when 'large'
      assign min_h_desktop = '820px'
    when 'full'
      assign min_h_desktop = '100vh'
    when 'adapt'
      if section.settings.image != blank
        assign min_h_desktop = 'auto'
      endif
  endcase

  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign scrim_alpha = section.settings.scrim_opacity | default: 92 | divided_by: 100.0
  assign box_opacity_alpha = section.settings.content_box_opacity | default: 78 | divided_by: 100.0
  assign box_blur_px = section.settings.content_box_blur | default: 12
-%}

<div class="tk-hero-wrapper{% if section.settings.layout == 'contained' %} tk-container tk-hero-wrapper--contained{% endif %}">
  <div
    class="tk-hero tk-hero--h-{{ section.settings.height }} tk-hero--style-{{ section.settings.content_style }} tk-hero--align-{{ section.settings.text_alignment }} tk-hero--pos-{{ section.settings.content_position }}{% if section.settings.mobile_layout == 'below' %} tk-hero--mobile-below{% else %} tk-hero--mobile-overlay{% endif %} color-{{ section.settings.color_scheme }} gradient"
    style="
      --tk-hero-min-height: {{ min_h_desktop }};
      --tk-hero-overlay: rgba(0, 0, 0, {{ overlay_alpha }});
      --tk-hero-scrim-alpha: {{ scrim_alpha }};
      --tk-hero-box-opacity: {{ box_opacity_alpha }};
      --tk-hero-box-blur: {{ box_blur_px }}px;
    "
  >
    <!-- Background Imagery -->
    <div class="tk-hero__media">
      {%- if section.settings.image != blank -%}
        {%- if section.settings.mobile_image != blank -%}
          <picture>
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.mobile_image | image_url: width: 750 }}"
            >
            {{
              section.settings.image
              | image_url: width: 2000
              | image_tag:
                widths: '750, 1100, 1500, 1780, 2000',
                sizes: '100vw',
                loading: loading_strategy,
                fetchpriority: fetch_priority,
                class: 'tk-hero__image',
                alt: section.settings.image.alt | default: shop.name | escape
            }}
          </picture>
        {%- else -%}
          {{
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              widths: '750, 1100, 1500, 1780, 2000',
              sizes: '100vw',
              loading: loading_strategy,
              fetchpriority: fetch_priority,
              class: 'tk-hero__image',
              alt: section.settings.image.alt | default: shop.name | escape
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'tk-placeholder-svg tk-hero__image' }}
      {%- endif -%}

      {%- if section.settings.content_style == 'gradient_scrim' -%}
        <div class="tk-hero__scrim"></div>
      {%- else -%}
        <div class="tk-hero__overlay"></div>
      {%- endif -%}
    </div>

    <!-- Content Area -->
    <div class="tk-hero__content-container">
      <div class="tk-hero__content-box{% if section.settings.content_style == 'frosted_box' and section.settings.show_content_box %} tk-hero__content-box--card{% if section.settings.content_box_border %} tk-hero__content-box--border{% endif %}{% if section.settings.content_box_opacity < 60 %} tk-hero__content-box--subtle-shadow{% endif %}{% endif %}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              {%- if block.settings.eyebrow != blank -%}
                <span class="tk-eyebrow tk-hero__eyebrow" {{ block.shopify_attributes }}>
                  {{ block.settings.eyebrow | escape }}
                </span>
              {%- endif -%}

            {%- when 'heading' -%}
              {%- if block.settings.heading != blank -%}
                {%- assign h_tag = block.settings.heading_tag | default: 'h1' -%}
                <{{ h_tag }}
                  class="tk-hero__heading {% if block.settings.heading_size == 'display' %}tk-hero__heading--display{% elsif block.settings.heading_size == 'large' %}tk-h1{% else %}tk-h2{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.heading }}
                </{{ h_tag }}>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div class="tk-hero__text tk-rte tk-text-muted" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>
              {%- endif -%}

            {%- when 'buttons' -%}
              <div class="tk-hero__buttons tk-cluster" {{ block.shopify_attributes }}>
                {%- if block.settings.button_1_label != blank -%}
                  {% render 'tk-button',
                    label: block.settings.button_1_label,
                    url: block.settings.button_1_link,
                    style: block.settings.button_1_style,
                    icon: 'arrow-right'
                  %}
                {%- endif -%}
                {%- if block.settings.button_2_label != blank -%}
                  {% render 'tk-button',
                    label: block.settings.button_2_label,
                    url: block.settings.button_2_link,
                    style: block.settings.button_2_style
                  %}
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_slide_counter -%}
        <div class="tk-hero__counter small-hide">
          <span>01</span>
          <span class="tk-hero__counter-bar"></span>
          <span>03</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .tk-hero-wrapper--contained {
    padding-top: 24px;
  }

  .tk-hero {
    position: relative;
    width: 100%;
    min-height: var(--tk-hero-min-height, 560px);
    overflow: hidden;
    display: flex;
    box-sizing: border-box;
  }

  .tk-hero-wrapper--contained .tk-hero {
    border-radius: var(--tk-radius-card);
  }

  .tk-hero__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .tk-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tk-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--tk-hero-overlay, rgba(0, 0, 0, 0));
  }

  .tk-hero__content-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--tk-container);
    margin: 0 auto;
    padding: 48px var(--tk-gutter);
    display: flex;
    box-sizing: border-box;
  }

  /* 9-Position Content Alignment */
  .tk-hero--pos-top-left .tk-hero__content-container { align-items: flex-start; justify-content: flex-start; }
  .tk-hero--pos-top-center .tk-hero__content-container { align-items: flex-start; justify-content: center; }
  .tk-hero--pos-top-right .tk-hero__content-container { align-items: flex-start; justify-content: flex-end; }
  .tk-hero--pos-middle-left .tk-hero__content-container { align-items: center; justify-content: flex-start; }
  .tk-hero--pos-middle-center .tk-hero__content-container { align-items: center; justify-content: center; }
  .tk-hero--pos-middle-right .tk-hero__content-container { align-items: center; justify-content: flex-end; }
  .tk-hero--pos-bottom-left .tk-hero__content-container { align-items: flex-end; justify-content: flex-start; }
  .tk-hero--pos-bottom-center .tk-hero__content-container { align-items: flex-end; justify-content: center; }
  .tk-hero--pos-bottom-right .tk-hero__content-container { align-items: flex-end; justify-content: flex-end; }

  /* --- Gradient Scrim (v2 Default Content Style) --- */
  .tk-hero__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      rgba(243, 239, 232, var(--tk-hero-scrim-alpha, 0.92)) 0%,
      rgba(243, 239, 232, calc(var(--tk-hero-scrim-alpha, 0.92) * 0.65)) 38%,
      rgba(243, 239, 232, 0) 62%
    );
  }

  .tk-hero--style-gradient_scrim .tk-hero__content-box {
    max-width: 640px;
    background: transparent;
    padding: 0;
    box-shadow: none;
    border: none;
  }

  .tk-hero__heading--display {
    font-family: var(--font-heading-family);
    font-weight: 350;
    font-size: clamp(56px, 8vw, 116px);
    line-height: 0.92;
    letter-spacing: -0.035em;
    margin-top: 0;
    margin-bottom: var(--tk-space-4);
    color: rgb(var(--color-foreground));
  }

  .tk-hero__heading--display em {
    font-family: var(--font-heading-family);
    font-style: italic;
    font-weight: 300;
  }

  .tk-hero__eyebrow {
    color: var(--tk-color-olive);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: var(--tk-space-3);
  }

  .tk-hero__counter {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--tk-color-muted);
    padding-bottom: 8px;
  }

  .tk-hero__counter-bar {
    width: 80px;
    height: 1px;
    background-color: var(--tk-color-ink);
  }

  /* Text alignments */
  .tk-hero--align-left .tk-hero__content-box { text-align: left; }
  .tk-hero--align-center .tk-hero__content-box { text-align: center; }
  .tk-hero--align-center .tk-hero__buttons { justify-content: center; }
  .tk-hero--align-right .tk-hero__content-box { text-align: right; }
  .tk-hero--align-right .tk-hero__buttons { justify-content: flex-end; }

  .tk-hero__content-box {
    max-width: 560px;
    width: 100%;
    box-sizing: border-box;
  }

  .tk-hero__content-box--card {
    background-color: rgb(var(--color-background) / 0.92);
    color: var(--tk-color-ink);
    border-radius: var(--tk-radius-card);
    padding: 40px;
    box-shadow: var(--tk-shadow-md);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .tk-hero__content-box--card {
      background: rgb(var(--color-background) / var(--tk-hero-box-opacity, 0.78));
      backdrop-filter: blur(var(--tk-hero-box-blur, 12px)) saturate(140%);
      -webkit-backdrop-filter: blur(var(--tk-hero-box-blur, 12px)) saturate(140%);
    }
  }

  .tk-hero__content-box--border {
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .tk-hero__content-box--subtle-shadow {
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
  }

  .tk-hero__heading {
    margin-top: 0;
    margin-bottom: var(--tk-space-3);
  }

  .tk-hero__text {
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: var(--tk-space-5);
  }

  .tk-hero__buttons {
    gap: 16px;
    align-items: center;
  }

  /* Mobile Layout (< 750px) */
  @media screen and (max-width: 749px) {
    .tk-hero {
      min-height: 600px !important;
      position: relative;
    }

    .tk-hero__media {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }

    .tk-hero__scrim {
      background: linear-gradient(
        0deg,
        rgba(243, 239, 232, 0.96) 0%,
        rgba(243, 239, 232, 0.8) 45%,
        rgba(243, 239, 232, 0) 75%
      );
    }

    .tk-hero__content-container {
      position: relative;
      min-height: 600px;
      padding: 24px 20px !important;
      display: flex;
      flex-direction: column;
      justify-content: flex-end !important;
      align-items: stretch !important;
      box-sizing: border-box;
    }

    .tk-hero__content-box {
      max-width: 100%;
      margin: 0 !important;
    }

    .tk-hero__content-box--card {
      padding: 24px;
      box-shadow: var(--tk-shadow-sm);
    }

    .tk-hero__heading--display,
    .tk-hero__heading.tk-h1,
    .tk-hero__heading.tk-h2 {
      font-size: 38px !important;
      line-height: 1.05;
      letter-spacing: -0.03em;
    }

    .tk-hero__buttons {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
    }

    .tk-hero__buttons .tk-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "section tk-hero-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "full_width", "label": "Full bleed (100vw)" },
        { "value": "contained", "label": "Contained (1360px)" }
      ],
      "default": "full_width"
    },
    {
      "type": "select",
      "id": "content_style",
      "label": "Content style",
      "options": [
        { "value": "gradient_scrim", "label": "Gradient scrim (v2 Editorial)" },
        { "value": "frosted_box", "label": "Frosted card box" }
      ],
      "default": "gradient_scrim"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)"
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "%",
      "label": "Gradient scrim opacity",
      "default": 92
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 0
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner height",
      "options": [
        { "value": "small", "label": "Small (560px)" },
        { "value": "medium", "label": "Medium (720px)" },
        { "value": "large", "label": "Large (820px)" },
        { "value": "full", "label": "Full screen (100vh)" },
        { "value": "adapt", "label": "Adapt to image" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_slide_counter",
      "label": "Show slide counter (01 / 03)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_content_box",
      "label": "Show content in card box (Frosted style only)",
      "default": true
    },
    {
      "type": "range",
      "id": "content_box_opacity",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "%",
      "label": "Content box opacity",
      "info": "Values below 60% automatically apply a subtle text shadow to preserve WCAG 4.5:1 legibility against busy imagery.",
      "default": 78
    },
    {
      "type": "range",
      "id": "content_box_blur",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Background blur",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "content_box_border",
      "label": "Box border",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "below", "label": "Text below image" },
        { "value": "overlay", "label": "Text over image" }
      ],
      "default": "overlay"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text",
          "default": "New Season Arrival"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Thoughtfully crafted organic apparel"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "display", "label": "Display (Hero clamp 56-116px)" },
            { "value": "large", "label": "Large (H1)" },
            { "value": "regular", "label": "Regular (H2)" }
          ],
          "default": "display"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading tag",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" }
          ],
          "default": "h1"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Discover sustainably sourced essentials made from certified organic cotton and pure natural fibres.</p>"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_1_label",
          "label": "Button 1 label",
          "default": "Shop collection"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Button 1 link"
        },
        {
          "type": "select",
          "id": "button_1_style",
          "label": "Button 1 style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "primary"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "Button 2 label",
          "default": "Explore story"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Button 2 link"
        },
        {
          "type": "select",
          "id": "button_2_style",
          "label": "Button 2 style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "outline"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
