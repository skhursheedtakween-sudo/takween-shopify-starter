{%- comment -%}
  sections/tk-style-guide.liquid
  Internal Developer QA Style Guide section.
  Previews all 5 colour schemes, status tokens, typography, buttons, badges, forms, and cards.
  No preset included so it cannot be accidentally added to production templates by merchants.
{%- endcomment -%}

<div class="tk-section color-{{ section.settings.color_scheme }} gradient">
  <div class="tk-container">
    <header style="margin-bottom: var(--tk-space-7); text-align: center;">
      <span class="tk-eyebrow">Takween Starter Theme</span>
      <h1 class="tk-h1">{{ 'tk.style_guide.title' | t }}</h1>
      <p class="tk-rte" style="max-width: 640px; margin: 0 auto; color: var(--tk-color-muted);">
        {{ 'tk.style_guide.subtitle' | t }}
      </p>
    </header>

    <!-- SECTION 1: COLOUR SCHEMES -->
    <section style="margin-bottom: var(--tk-space-8);">
      <h2 class="tk-h2">1. Colour Schemes (Dawn OS 2.0 Integration)</h2>
      <p class="tk-text-muted" style="margin-bottom: var(--tk-space-4);">
        The 5 configured presets mapped to Dawn colour schemes:
      </p>

      <div class="tk-grid" style="--tk-grid-cols-desktop: 5; --tk-grid-cols-tablet: 3; --tk-grid-cols-mobile: 1;">
        <div class="color-scheme-1 gradient" style="padding: var(--tk-space-4); border-radius: var(--tk-radius-card); border: 1px solid var(--tk-color-border);">
          <strong>Scheme 1</strong><br>
          <small>Light (Default)</small><br>
          Bg: #F6F5F2<br>Text: #16181B
        </div>
        <div class="color-scheme-2 gradient" style="padding: var(--tk-space-4); border-radius: var(--tk-radius-card); border: 1px solid var(--tk-color-border);">
          <strong>Scheme 2</strong><br>
          <small>White Surface</small><br>
          Bg: #FFFFFF<br>Text: #16181B
        </div>
        <div class="color-scheme-3 gradient" style="padding: var(--tk-space-4); border-radius: var(--tk-radius-card); border: 1px solid var(--tk-color-border);">
          <strong>Scheme 3</strong><br>
          <small>Dark</small><br>
          Bg: #16181B<br>Text: #F6F5F2
        </div>
        <div class="color-scheme-4 gradient" style="padding: var(--tk-space-4); border-radius: var(--tk-radius-card); border: 1px solid var(--tk-color-border);">
          <strong>Scheme 4</strong><br>
          <small>Accent</small><br>
          Bg: #1F4FD8<br>Text: #FFFFFF
        </div>
        <div class="color-scheme-5 gradient" style="padding: var(--tk-space-4); border-radius: var(--tk-radius-card); border: 1px solid var(--tk-color-border);">
          <strong>Scheme 5</strong><br>
          <small>Tint</small><br>
          Bg: #ECEAE5<br>Text: #16181B
        </div>
      </div>
    </section>

    <!-- SECTION 2: STATUS COLOURS -->
    <section style="margin-bottom: var(--tk-space-8);">
      <h2 class="tk-h2">2. Status & E-Commerce Feedback Tokens</h2>
      <div class="tk-grid" style="--tk-grid-cols-desktop: 4; --tk-grid-cols-tablet: 2; --tk-grid-cols-mobile: 1;">
        <div class="tk-card-box">
          <span class="tk-badge tk-badge--sale" style="margin-bottom: var(--tk-space-2);">Sale Badge</span>
          <div style="color: var(--tk-color-sale); font-weight: 700;">Sale Price Token: {{ settings.tk_color_sale }}</div>
        </div>
        <div class="tk-card-box">
          <div class="tk-stock tk-stock--in" style="margin-bottom: var(--tk-space-2);">
            <span class="tk-stock__dot"></span> In stock status
          </div>
          <div style="color: var(--tk-color-success); font-weight: 600;">Success Token: {{ settings.tk_color_success }}</div>
        </div>
        <div class="tk-card-box">
          <div class="tk-stock tk-stock--low" style="margin-bottom: var(--tk-space-2);">
            <span class="tk-stock__dot"></span> Low stock (Only 3 left)
          </div>
          <div style="color: var(--tk-color-low-stock); font-weight: 600;">Low Stock Token: {{ settings.tk_color_low_stock }}</div>
        </div>
        <div class="tk-card-box">
          <span class="tk-badge tk-badge--soldout" style="margin-bottom: var(--tk-space-2);">Sold Out Badge</span>
          <div style="color: var(--tk-color-soldout); font-weight: 700;">Sold Out Token: {{ settings.tk_color_sold_out }}</div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: TYPOGRAPHY SCALE -->
    <section style="margin-bottom: var(--tk-space-8);">
      <h2 class="tk-h2">3. Typography Scale (Fluid Clamp)</h2>
      <div class="tk-card-box tk-stack" style="--tk-stack-gap: var(--tk-space-4);">
        <div>
          <span class="tk-eyebrow">Eyebrow (13px, Bold, Uppercase, 0.1em tracking)</span>
          <h1 class="tk-h1" style="margin-bottom: 0;">Heading 1 (52px &rarr; 34px, 800)</h1>
        </div>
        <h2 class="tk-h2" style="margin-bottom: 0;">Heading 2 (36px &rarr; 26px, 800)</h2>
        <h3 class="tk-h3" style="margin-bottom: 0;">Heading 3 (22px &rarr; 18px, 700)</h3>
        <p class="tk-card-title">Card Title (16px, 700, 1.35 line-height)</p>
        <p class="tk-rte">Body text (16px, line-height 1.6). This text demonstrates standard paragraph styling, neutral legibility, and contrast against the default page background.</p>
        <small class="tk-text-muted">Small text / Secondary description (13–14px)</small>
      </div>
    </section>

    <!-- SECTION 4: BUTTONS & BADGES -->
    <section style="margin-bottom: var(--tk-space-8);">
      <h2 class="tk-h2">4. Buttons & Badges</h2>
      <div class="tk-card-box tk-stack" style="--tk-stack-gap: var(--tk-space-5);">
        <div>
          <h3 class="tk-h3">Button Styles</h3>
          <div class="tk-cluster" style="margin-top: var(--tk-space-3);">
            <button type="button" class="tk-btn tk-btn--primary">Primary Button</button>
            <button type="button" class="tk-btn tk-btn--secondary">Secondary Button</button>
            <button type="button" class="tk-btn tk-btn--outline">Outline Button</button>
            <button type="button" class="tk-btn tk-btn--link">Text Link Button</button>
            <button type="button" class="tk-btn tk-btn--primary" disabled>Disabled Button</button>
          </div>
        </div>
        <div>
          <h3 class="tk-h3">Badge Variants</h3>
          <div class="tk-cluster" style="margin-top: var(--tk-space-3);">
            <span class="tk-badge tk-badge--sale">Sale</span>
            <span class="tk-badge tk-badge--sale">-25%</span>
            <span class="tk-badge tk-badge--soldout">Sold out</span>
            <span class="tk-badge tk-badge--custom">Best seller</span>
            <span class="tk-badge tk-badge--custom">Staff pick</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: FORM CONTROLS -->
    <section style="margin-bottom: var(--tk-space-8);">
      <h2 class="tk-h2">5. Form Fields & Feedback</h2>
      <div class="tk-card-box">
        <div class="tk-grid" style="--tk-grid-cols-desktop: 2; --tk-grid-cols-tablet: 2; --tk-grid-cols-mobile: 1;">
          <div class="tk-field">
            <label for="sample-input-normal" class="tk-label">Default Input Field</label>
            <input type="text" id="sample-input-normal" class="tk-input" placeholder="e.g. John Doe">
          </div>
          <div class="tk-field tk-field--error">
            <label for="sample-input-error" class="tk-label">Error State Input Field</label>
            <input type="email" id="sample-input-error" class="tk-input" value="invalid-email" aria-invalid="true" aria-describedby="sample-error-msg">
            <span id="sample-error-msg" class="tk-field__error-msg">Please enter a valid email address.</span>
          </div>
        </div>
        <div style="margin-top: var(--tk-space-4);">
          <div class="tk-alert--success" role="status">
            &check; Success alert: Item added or form submitted successfully.
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 6: TOKENS OVERVIEW -->
    <section>
      <h2 class="tk-h2">6. Shape, Spacing & Container Tokens</h2>
      <div class="tk-card-box">
        <div class="tk-grid" style="--tk-grid-cols-desktop: 3; --tk-grid-cols-tablet: 2; --tk-grid-cols-mobile: 1;">
          <div>
            <strong>Container max-width:</strong> {{ settings.tk_container_width | default: 1280 }}px<br>
            <strong>Grid gap:</strong> {{ settings.tk_grid_gap | default: 24 }}px<br>
            <strong>Spacing scale:</strong> {{ settings.tk_spacing_scale | default: 'default' }}
          </div>
          <div>
            <strong>Button radius:</strong> {{ settings.tk_button_radius | default: 8 }}px<br>
            <strong>Card radius:</strong> {{ settings.tk_card_radius | default: 12 }}px<br>
            <strong>Input radius:</strong> {{ settings.tk_input_radius | default: 8 }}px
          </div>
          <div>
            <strong>Button height:</strong> 48px<br>
            <strong>Touch target min:</strong> 44&times;44px<br>
            <strong>Focus ring:</strong> 2px solid accent
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "Takween Style Guide",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
