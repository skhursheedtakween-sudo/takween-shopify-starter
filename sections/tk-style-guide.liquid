{%- comment -%}
  sections/tk-style-guide.liquid
  Internal Developer QA Style Guide section.
  Previews all 5 colour schemes, status tokens, typography, buttons, interaction states, badges, forms, and cards.
  No preset included so it cannot be accidentally added to production templates by merchants.
{%- endcomment -%}

<div class="tk-section color-{{ section.settings.color_scheme }} gradient">
  <div class="tk-container">
    <header style="margin-bottom: var(--tk-space-7); text-align: center;">
      <span class="tk-eyebrow">Takween Starter Theme</span>
      <h1 class="tk-h1">{{ 'tk.style_guide.title' | t }}</h1>
      <p class="tk-rte" style="max-width: 640px; margin: 0 auto; color: var(--tk-color-muted);">
        {{ 'tk.style_guide.subtitle' | t }}
      </p>
    </header>

    <!-- SECTION 1: COLOUR SCHEMES -->
    <section style="margin-bottom: var(--tk-space-8);">
      <h2 class="tk-h2">1. Colour Schemes (v2 Premium Editorial)</h2>
      <p class="tk-text-muted" style="margin-bottom: var(--tk-space-4);">
        The 5 configured presets mapped to Dawn colour schemes:
      </p>

      <div class="tk-grid" style="--tk-grid-cols-desktop: 5; --tk-grid-cols-tablet: 3; --tk-grid-cols-mobile: 1;">
        <div class="color-scheme-1 gradient" style="padding: var(--tk-space-4); border-radius: var(--tk-radius-card); border: 1px solid var(--tk-color-border);">
          <strong>Scheme 1</strong><br>
          <small>Linen (Default)</small><br>
          Bg: #F3EFE8<br>Text: #1C1A17
        </div>
        <div class="color-scheme-2 gradient" style="padding: var(--tk-space-4); border-radius: var(--tk-radius-card); border: 1px solid var(--tk-color-border);">
          <strong>Scheme 2</strong><br>
          <small>Paper (Surface)</small><br>
          Bg: #FBF9F5<br>Text: #1C1A17
        </div>
        <div class="color-scheme-3 gradient" style="padding: var(--tk-space-4); border-radius: var(--tk-radius-card); border: 1px solid var(--tk-color-border);">
          <strong>Scheme 3</strong><br>
          <small>Espresso (Dark)</small><br>
          Bg: #1C1A17<br>Text: #EDE6DA
        </div>
        <div class="color-scheme-4 gradient" style="padding: var(--tk-space-4); border-radius: var(--tk-radius-card); border: 1px solid var(--tk-color-border);">
          <strong>Scheme 4</strong><br>
          <small>Sand</small><br>
          Bg: #E3DACB<br>Text: #1C1A17
        </div>
        <div class="color-scheme-5 gradient" style="padding: var(--tk-space-4); border-radius: var(--tk-radius-card); border: 1px solid var(--tk-color-border);">
          <strong>Scheme 5</strong><br>
          <small>Stone</small><br>
          Bg: #ECE6DC<br>Text: #1C1A17
        </div>
      </div>
    </section>

    <!-- SECTION 2: STATUS COLOURS -->
    <section style="margin-bottom: var(--tk-space-8);">
      <h2 class="tk-h2">2. Status & E-Commerce Feedback Tokens</h2>
      <div class="tk-grid" style="--tk-grid-cols-desktop: 4; --tk-grid-cols-tablet: 2; --tk-grid-cols-mobile: 1;">
        <div class="tk-card-box">
          <span class="tk-badge tk-badge--sale" style="margin-bottom: var(--tk-space-2);">Sale Badge</span>
          <div style="color: var(--tk-color-sale); font-weight: 700;">Sale Price: {{ settings.tk_color_sale }}</div>
        </div>
        <div class="tk-card-box">
          <div class="tk-stock tk-stock--in" style="margin-bottom: var(--tk-space-2);">
            <span class="tk-stock__dot"></span> In stock status
          </div>
          <div style="color: var(--tk-color-success); font-weight: 600;">Success: {{ settings.tk_color_success }}</div>
        </div>
        <div class="tk-card-box">
          <div class="tk-stock tk-stock--low" style="margin-bottom: var(--tk-space-2);">
            <span class="tk-stock__dot"></span> Low stock (Only 3 left)
          </div>
          <div style="color: var(--tk-color-low-stock); font-weight: 600;">Low Stock: {{ settings.tk_color_low_stock }}</div>
        </div>
        <div class="tk-card-box">
          <span class="tk-badge tk-badge--soldout" style="margin-bottom: var(--tk-space-2);">Sold Out Badge</span>
          <div style="color: var(--tk-color-soldout); font-weight: 700;">Sold Out: {{ settings.tk_color_sold_out }}</div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: TYPOGRAPHY SCALE -->
    <section style="margin-bottom: var(--tk-space-8);">
      <h2 class="tk-h2">3. Typography Scale (Fluid Clamp & Explicit Targets)</h2>
      <p class="tk-text-muted" style="margin-bottom: var(--tk-space-4);">
        Each sample displays its token name and target desktop &rarr; mobile computed pixel size:
      </p>
      <div class="tk-card-box tk-stack" style="--tk-stack-gap: var(--tk-space-5);">
        <div>
          <span class="tk-eyebrow">Eyebrow &middot; 13px (Mobile 12px)</span>
          <h1 class="tk-h1" style="margin-bottom: 0;">Heading 1 &middot; 52px (Mobile 34px)</h1>
        </div>
        <div>
          <h2 class="tk-h2" style="margin-bottom: 0;">Heading 2 &middot; 36px (Mobile 26px)</h2>
        </div>
        <div>
          <h3 class="tk-h3" style="margin-bottom: 0;">Heading 3 &middot; 22px (Mobile 18px)</h3>
        </div>
        <div>
          <p class="tk-card-title">Card title &middot; 16px (Mobile 15px)</p>
        </div>
        <div>
          <p class="tk-rte" style="margin-bottom: var(--tk-space-1);">
            Body text &middot; 16px (Mobile 16px) &mdash; This paragraph demonstrates default body copy scale, line-height 1.6, and link interaction: <a href="#test-link">Sample link with hover accent</a>.
          </p>
        </div>
        <div>
          <small class="tk-text-muted">Small text &middot; 14px (Mobile 14px)</small>
        </div>
      </div>
    </section>

    <!-- SECTION 4: BUTTONS & INTERACTION STATES -->
    <section style="margin-bottom: var(--tk-space-8);">
      <h2 class="tk-h2">4. Buttons & Interaction States</h2>
      <p class="tk-text-muted" style="margin-bottom: var(--tk-space-3);">
        <em>Hover or focus buttons below to preview live interaction states (translateY(-1px), shadow-sm, darken):</em>
      </p>

      <div class="tk-card-box tk-stack" style="--tk-stack-gap: var(--tk-space-5);">
        <div>
          <h3 class="tk-h3">Interactive Buttons (Hover / Focus / Active)</h3>
          <div class="tk-cluster" style="margin-top: var(--tk-space-3);">
            <button type="button" class="tk-btn tk-btn--primary">Primary &middot; 15px</button>
            <button type="button" class="tk-btn tk-btn--secondary">Secondary &middot; 15px</button>
            <button type="button" class="tk-btn tk-btn--outline">Outline &middot; 15px</button>
            <button type="button" class="tk-btn tk-btn--link">Text Link &middot; 15px</button>
            <button type="button" class="tk-btn tk-btn--primary" disabled>Disabled State</button>
          </div>
        </div>

        <div>
          <h3 class="tk-h3">Static State Previews for Comparison</h3>
          <div class="tk-cluster" style="margin-top: var(--tk-space-3);">
            <button type="button" class="tk-btn tk-btn--primary is-hover">Primary (Simulated Hover)</button>
            <button type="button" class="tk-btn tk-btn--secondary is-hover">Secondary (Simulated Hover)</button>
            <button type="button" class="tk-btn tk-btn--outline is-hover">Outline (Simulated Hover)</button>
            <button type="button" class="tk-btn tk-btn--link is-hover">Link (Simulated Hover)</button>
            <button type="button" class="tk-btn tk-btn--primary is-disabled">Primary (Disabled 0.6)</button>
          </div>
        </div>

        <div>
          <h3 class="tk-h3">Badge Variants</h3>
          <div class="tk-cluster" style="margin-top: var(--tk-space-3);">
            <span class="tk-badge tk-badge--sale">Sale</span>
            <span class="tk-badge tk-badge--sale">-25%</span>
            <span class="tk-badge tk-badge--soldout">Sold out</span>
            <span class="tk-badge tk-badge--custom">Best seller</span>
            <span class="tk-badge tk-badge--custom">Staff pick</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: FORM CONTROLS & PILLS -->
    <section style="margin-bottom: var(--tk-space-8);">
      <h2 class="tk-h2">5. Form Fields, Inputs & Pills (Hover & Focus)</h2>
      <div class="tk-card-box tk-stack" style="--tk-stack-gap: var(--tk-space-4);">
        <div class="tk-grid" style="--tk-grid-cols-desktop: 2; --tk-grid-cols-tablet: 2; --tk-grid-cols-mobile: 1;">
          <div class="tk-field">
            <label for="sample-input-normal" class="tk-label">Default Input (16px minimum &mdash; prevents iOS zoom)</label>
            <input type="text" id="sample-input-normal" class="tk-input" placeholder="e.g. John Doe">
          </div>
          <div class="tk-field tk-field--error">
            <label for="sample-input-error" class="tk-label">Error State Input (Hover border ink / error red)</label>
            <input type="email" id="sample-input-error" class="tk-input" value="invalid-email" aria-invalid="true" aria-describedby="sample-error-msg">
            <span id="sample-error-msg" class="tk-field__error-msg">Please enter a valid email address.</span>
          </div>
        </div>

        <div>
          <span class="tk-label" style="display: block; margin-bottom: var(--tk-space-2);">Option Pills / Swatches (Hover border turns ink)</span>
          <div class="tk-cluster">
            <button type="button" class="tk-pill">Small</button>
            <button type="button" class="tk-pill">Medium</button>
            <button type="button" class="tk-pill">Large</button>
          </div>
        </div>

        <div>
          <div class="tk-alert--success" role="status">
            &check; Success alert: Item added or form submitted successfully.
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 6: TOKENS OVERVIEW -->
    <section style="margin-bottom: var(--tk-space-8);">
      <h2 class="tk-h2">6. Shape, Spacing & Container Tokens</h2>
      <div class="tk-card-box">
        <div class="tk-grid" style="--tk-grid-cols-desktop: 3; --tk-grid-cols-tablet: 2; --tk-grid-cols-mobile: 1;">
          <div>
            <strong>Container max-width:</strong> {{ settings.tk_container_width | default: 1360 }}px<br>
            <strong>Grid gap:</strong> {{ settings.tk_grid_gap | default: 20 }}px<br>
            <strong>Spacing scale:</strong> {{ settings.tk_spacing_scale | default: 'default' }}
          </div>
          <div>
            <strong>Button radius:</strong> {{ settings.tk_button_radius | default: 999 }}px (pill)<br>
            <strong>Card/Media radius:</strong> {{ settings.tk_card_radius | default: 4 }}px<br>
            <strong>Input radius:</strong> {{ settings.tk_input_radius | default: 4 }}px
          </div>
          <div>
            <strong>Primary button min-height:</strong> 54px<br>
            <strong>Touch target min:</strong> 44&times;44px<br>
            <strong>Focus ring:</strong> 2px solid ink (offset 3px)
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 7: PRODUCT CARD PREVIEWS (QA) -->
    <section>
      <h2 class="tk-h2">7. Product Card Previews (QA Test Cases)</h2>
      <p class="tk-text-muted" style="margin-bottom: var(--tk-space-4);">
        Testing: 1) Organic Cotton Tee (images + hover + swatches + custom badge), 2) Relaxed Overshirt (sale + placeholder image), 3) Ceramic Mug Set (sold out single variant), 4) Long title 2-line clamp test.
      </p>

      <div class="tk-grid" style="--tk-grid-cols-desktop: 4; --tk-grid-cols-tablet: 2; --tk-grid-cols-mobile: 2;">
        {%- assign test_handles = 'sample-organic-cotton-tee,sample-relaxed-overshirt,sample-ceramic-mug-set,sample-canvas-tote-bag' | split: ',' -%}
        {%- for handle in test_handles -%}
          {%- assign card_prod = all_products[handle] -%}
          {%- if card_prod != blank -%}
            <div>
              {% render 'tk-product-card', product: card_prod, section_id: section.id %}
            </div>
          {%- endif -%}
        {%- endfor -%}

        <!-- Custom block picks if configured via blocks -->
        {%- for block in section.blocks -%}
          {%- if block.type == 'product_card_preview' and block.settings.product != blank -%}
            <div {{ block.shopify_attributes }}>
              {% render 'tk-product-card', product: block.settings.product, section_id: section.id %}
            </div>
          {%- endif -%}
        {%- endfor -%}

        <!-- Synthetic Card: 2-line title clamp test -->
        <div>
          <div class="tk-product-card">
            <div class="tk-product-card__media-wrapper tk-product-card__media-wrapper--portrait">
              <span class="tk-product-card__badge tk-product-card__badge--sale" style="position: absolute; top: 12px; left: 12px; z-index: 2;">
                Sale
              </span>
              {{ 'product-apparel-2' | placeholder_svg_tag: 'tk-placeholder-svg' }}
            </div>
            <div class="tk-product-card__content">
              <div class="tk-product-card__vendor">Takween Sample Co.</div>
              <h3 class="tk-product-card__title">
                <a href="#test" class="tk-product-card__link">
                  Super Extra Long Product Title For QA Checking That The Two-Line Clamping Feature Works Reliably On Desktop And Mobile
                </a>
              </h3>
              <div class="tk-product-card__price-row">
                <div class="tk-price tk-price--on-sale">
                  <span class="tk-price__item tk-price__item--sale">£45.00</span>
                  <s class="tk-price__item tk-price__item--regular">£60.00</s>
                </div>
              </div>
              <div class="tk-product-card__swatches">
                <div class="tk-swatches__list">
                  <span class="tk-swatch" style="background-color: #D8CDB8;"></span>
                  <span class="tk-swatch" style="background-color: #3A3D42;"></span>
                  <span class="tk-swatch" style="background-color: #6B7A55;"></span>
                  <span class="tk-swatches__more tk-text-muted">+2</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "Takween Style Guide",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "product_card_preview",
      "name": "Product Card Preview",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ]
}
{% endschema %}
