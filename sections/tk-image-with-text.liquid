{%- comment -%}
  sections/tk-image-with-text.liquid
  Takween Image with Text Section.
  Reversible split section with image ratio/width settings, checklist block, and button CTA.
  Default: scheme-2 (white surface), 1px border top/bottom, 72px desktop padding, 56px gap.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if section.settings.show_borders -%}
    .tk-iwt--bordered-{{ section.id }} {
      border-top: 1px solid var(--tk-color-border);
      border-bottom: 1px solid var(--tk-color-border);
    }
  {%- endif -%}
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_borders %} tk-iwt--bordered-{{ section.id }}{% endif %}">
  <div class="tk-container section-{{ section.id }}-padding">
    <div class="tk-iwt tk-iwt--valign-{{ section.settings.vertical_alignment }}{% if section.settings.reverse_layout %} tk-iwt--reverse-desktop{% endif %}{% if section.settings.mobile_order == 'text_first' %} tk-iwt--mobile-text-first{% endif %}">
      <!-- Media Column -->
      <div class="tk-iwt__media-col tk-iwt__media-col--{{ section.settings.image_width }}">
        <div class="tk-iwt__media tk-iwt__media--{{ section.settings.image_ratio }}">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1500
              | image_tag:
                widths: '375, 550, 750, 1100, 1500',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'lazy',
                class: 'tk-iwt__image',
                alt: section.settings.image.alt | default: section.settings.heading | escape
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'tk-placeholder-svg tk-iwt__image' }}
          {%- endif -%}
        </div>
      </div>

      <!-- Text / Content Column -->
      <div class="tk-iwt__content-col">
        <div class="tk-iwt__content">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'eyebrow' -%}
                {%- if block.settings.eyebrow != blank -%}
                  <span class="tk-eyebrow tk-iwt__eyebrow" {{ block.shopify_attributes }}>
                    {{ block.settings.eyebrow | escape }}
                  </span>
                {%- endif -%}

              {%- when 'heading' -%}
                {%- if block.settings.heading != blank -%}
                  {%- assign h_tag = block.settings.heading_tag | default: 'h2' -%}
                  <{{ h_tag }} class="tk-h2 tk-iwt__heading" {{ block.shopify_attributes }}>
                    {{ block.settings.heading | escape }}
                  </{{ h_tag }}>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                  <div class="tk-rte tk-iwt__text tk-text-muted" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}

              {%- when 'list_item' -%}
                {%- if block.settings.text != blank -%}
                  <div class="tk-iwt__list-item" {{ block.shopify_attributes }}>
                    <div class="tk-iwt__list-icon">
                      {%- assign list_icon = block.settings.icon | default: 'check' -%}
                      {% render 'tk-icon', icon: list_icon, size: 18 %}
                    </div>
                    <span class="tk-iwt__list-text">{{ block.settings.text | escape }}</span>
                  </div>
                {%- endif -%}

              {%- when 'button' -%}
                {%- if block.settings.button_label != blank -%}
                  <div class="tk-iwt__button-wrap" {{ block.shopify_attributes }}>
                    {% render 'tk-button',
                      label: block.settings.button_label,
                      url: block.settings.button_link,
                      style: block.settings.button_style
                    %}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .tk-iwt {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-6);
  }

  .tk-iwt--mobile-text-first {
    flex-direction: column-reverse;
  }

  .tk-iwt__media-col {
    width: 100%;
  }

  .tk-iwt__media {
    position: relative;
    border-radius: var(--tk-radius-card);
    overflow: hidden;
    background-color: var(--tk-color-tint);
    width: 100%;
  }

  .tk-iwt__media--ratio_5_4 {
    aspect-ratio: 5 / 4;
  }

  .tk-iwt__media--square {
    aspect-ratio: 1 / 1;
  }

  .tk-iwt__media--portrait {
    aspect-ratio: 4 / 5;
  }

  .tk-iwt__media--landscape {
    aspect-ratio: 16 / 9;
  }

  .tk-iwt__media--adapt {
    aspect-ratio: auto;
  }

  .tk-iwt__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tk-iwt__content-col {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .tk-iwt__content {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-3);
  }

  .tk-iwt__eyebrow {
    color: var(--tk-color-accent);
  }

  .tk-iwt__heading {
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 800;
  }

  .tk-iwt__text {
    font-size: 1.7rem;
    line-height: 1.6;
    margin: 0;
  }

  .tk-iwt__list-item {
    display: flex;
    align-items: center;
    gap: var(--tk-space-2);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--tk-color-ink);
  }

  .tk-iwt__list-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--tk-color-success);
    flex-shrink: 0;
  }

  .tk-iwt__button-wrap {
    margin-top: var(--tk-space-3);
  }

  @media screen and (min-width: 990px) {
    .tk-iwt {
      flex-direction: row;
      align-items: center;
      gap: 56px;
    }

    .tk-iwt--valign-top {
      align-items: flex-start;
    }

    .tk-iwt--valign-bottom {
      align-items: flex-end;
    }

    .tk-iwt--reverse-desktop {
      flex-direction: row-reverse;
    }

    .tk-iwt__media-col--40 {
      flex: 0 0 40%;
      max-width: 40%;
    }

    .tk-iwt__media-col--50 {
      flex: 0 0 calc(50% - 28px);
      max-width: calc(50% - 28px);
    }

    .tk-iwt__media-col--60 {
      flex: 0 0 60%;
      max-width: 60%;
    }

    .tk-iwt__content-col {
      flex: 1 1 auto;
      max-width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "tk-section-image-with-text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "ratio_5_4",
          "label": "5:4"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        },
        {
          "value": "landscape",
          "label": "Landscape (16:9)"
        },
        {
          "value": "adapt",
          "label": "Adapt to image"
        }
      ],
      "default": "ratio_5_4"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Desktop image width",
      "options": [
        {
          "value": "40",
          "label": "40%"
        },
        {
          "value": "50",
          "label": "50%"
        },
        {
          "value": "60",
          "label": "60%"
        }
      ],
      "default": "50"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse layout (image right)",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile order",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Text first"
        }
      ],
      "default": "image_first"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Desktop content alignment",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "middle"
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "Show top and bottom borders",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text",
          "default": "Traceable Quality"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Built for comfort, designed to endure."
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading tag",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Every garment is cut from certified organic fibers, milled under fair working conditions, and constructed with reinforced stitching.</p>"
        }
      ]
    },
    {
      "type": "list_item",
      "name": "List item",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "return",
              "label": "Return"
            }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "100% GOTS certified organic cotton"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Learn more about our standards"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "outline",
              "label": "Outline"
            },
            {
              "value": "link",
              "label": "Link"
            }
          ],
          "default": "secondary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        {
          "type": "eyebrow"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "list_item",
          "settings": {
            "icon": "check",
            "text": "100% GOTS certified organic cotton"
          }
        },
        {
          "type": "list_item",
          "settings": {
            "icon": "check",
            "text": "Pre-washed for zero shrinkage"
          }
        },
        {
          "type": "list_item",
          "settings": {
            "icon": "check",
            "text": "Reinforced double-needle seams"
          }
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
