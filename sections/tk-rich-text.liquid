{%- comment -%}
  sections/tk-rich-text.liquid
  Takween Rich Text / Brand Statement Section.
  Eyebrow, prominent heading, readable copy clamp, optional button CTA.
  Contained width setting (narrow 560px, normal 720px, wide 960px).
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .tk-rich-text-{{ section.id }} {
    max-width: var(--tk-rich-text-max-width, 720px);
    margin-inline: auto;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="tk-container section-{{ section.id }}-padding">
    <div
      class="tk-rich-text tk-rich-text-{{ section.id }} tk-rich-text--{{ section.settings.alignment }}"
      style="
        {%- case section.settings.content_width -%}
          {%- when 'narrow' -%}--tk-rich-text-max-width: 560px;
          {%- when 'normal' -%}--tk-rich-text-max-width: 720px;
          {%- when 'wide' -%}--tk-rich-text-max-width: 960px;
        {%- endcase -%}
      "
    >
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            {%- if block.settings.eyebrow != blank -%}
              <span class="tk-eyebrow tk-rich-text__eyebrow" {{ block.shopify_attributes }}>
                {{ block.settings.eyebrow | escape }}
              </span>
            {%- endif -%}

          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              {%- assign h_tag = block.settings.heading_tag | default: 'h2' -%}
              <{{ h_tag }}
                class="tk-rich-text__heading {% if block.settings.heading_size == 'large' %}tk-h1{% elsif block.settings.heading_size == 'small' %}tk-h3{% else %}tk-h2{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.heading | escape }}
              </{{ h_tag }}>
            {%- endif -%}

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="tk-rte tk-rich-text__body tk-text-muted" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- endif -%}

          {%- when 'caption' -%}
            {%- if block.settings.caption != blank -%}
              <p class="tk-caption tk-rich-text__caption tk-text-muted" {{ block.shopify_attributes }}>
                {{ block.settings.caption | escape }}
              </p>
            {%- endif -%}

          {%- when 'button' -%}
            {%- if block.settings.button_label != blank -%}
              <div class="tk-rich-text__button-wrapper" {{ block.shopify_attributes }}>
                {% render 'tk-button',
                  label: block.settings.button_label,
                  url: block.settings.button_link,
                  style: block.settings.button_style
                %}
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .tk-rich-text {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-3);
  }

  .tk-rich-text--center {
    align-items: center;
    text-align: center;
  }

  .tk-rich-text--left {
    align-items: flex-start;
    text-align: left;
  }

  .tk-rich-text--right {
    align-items: flex-end;
    text-align: right;
  }

  .tk-rich-text__eyebrow {
    color: var(--tk-color-accent);
  }

  .tk-rich-text__heading {
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 800;
  }

  .tk-rich-text__body {
    font-size: 1.7rem;
    line-height: 1.6;
    margin: 0;
  }

  .tk-rich-text__caption {
    font-size: 1.4rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0;
  }

  .tk-rich-text__button-wrapper {
    margin-top: var(--tk-space-2);
  }
</style>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "tk-section-rich-text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow (560px)"
        },
        {
          "value": "normal",
          "label": "Normal (720px)"
        },
        {
          "value": "wide",
          "label": "Wide (960px)"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text",
          "default": "About Our Craft"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Honest essentials crafted to last a lifetime."
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "regular",
              "label": "Regular"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ],
          "default": "regular"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading tag",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 2,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We design timeless wardrobe staples and home goods using sustainably sourced materials, ethical European mills, and rigorous craftsmanship.</p>"
        }
      ]
    },
    {
      "type": "caption",
      "name": "Caption",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "label": "Caption text",
          "default": "Est. 2024 · Designed in London"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Discover Our Story"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "outline",
              "label": "Outline"
            },
            {
              "value": "link",
              "label": "Link"
            }
          ],
          "default": "outline"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        {
          "type": "eyebrow"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
